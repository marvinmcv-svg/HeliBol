{
  "name": "kinetik",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm registry && pnpm --filter @kinetik/docs dev",
    "build": "pnpm registry && turbo run build",
    "registry": "node scripts/gen-registry.mjs",
    "typecheck": "pnpm registry && turbo run typecheck",
    "test": "pnpm registry && turbo run test",
    "lint": "turbo run lint",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
